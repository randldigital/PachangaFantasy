# Copy to .env and fill in local values. Never commit .env.

DATABASE_URL=postgresql://pachanga_user:password@localhost:5432/pachanga
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=5000

# Optional: API tests use DATABASE_URL plus a pachanga_test schema (created automatically).
# Set TEST_DATABASE_URL only if tests should hit a different database.
# TEST_DATABASE_URL=postgresql://pachanga_user:password@localhost:5432/pachanga_test
TEST_SCHEMA=pachanga_test

# Public origin for verify emails and later OAuth redirects (no trailing slash).
# PUBLIC_URL=http://localhost:5000

# Avatar and other local files. Later this can point at a mounted volume or be replaced by object storage.
# STORAGE_DIR=uploads

# Mail. If SMTP_HOST is empty, registration returns 503 EMAIL_NOT_CONFIGURED.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Pachanga <noreply@localhost>

# Google sign-in. Both empty ⇒ OAuth routes return 501 and the UI hides the button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Commercial flags. Default off.
# PAYMENTS_ENABLED=false
# ADS_ENABLED=false
# FEATURE_DEFAULT_PLAN=free

# Extra browser/WebView origins for a later packaged app. Empty = same-origin only (no CORS headers).
# CORS_ORIGINS=https://localhost,capacitor://localhost

# Hidden /analytics traction dashboard. Default 2026. Not linked from the product UI.
# ANALYTICS_PASSCODE=2026
