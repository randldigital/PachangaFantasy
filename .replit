modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33223
externalPort = 3003

[[ports]]
localPort = 33679
externalPort = 3001

[[ports]]
localPort = 34417
externalPort = 6800

[[ports]]
localPort = 35279
externalPort = 5173

[[ports]]
localPort = 36305
externalPort = 3000

[[ports]]
localPort = 36341
externalPort = 8000

[[ports]]
localPort = 36841
externalPort = 6000

[[ports]]
localPort = 37811
externalPort = 5000

[[ports]]
localPort = 38061
externalPort = 4200

[[ports]]
localPort = 40899
externalPort = 3002

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000
